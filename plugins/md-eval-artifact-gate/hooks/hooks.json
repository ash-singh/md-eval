{
  "description": "Check written pages with md-eval before the Artifact tool publishes them; send weak or risky pages back once per file per session",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --quiet --from git+https://github.com/ash-singh/md-eval@31ae6aa84567d14aec4484e002d68f18cfdb2ddc md-eval-artifact-hook || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
