{
  "description": "Score plans with md-eval before ExitPlanMode; send weak plans back once per session",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --quiet --from git+https://github.com/ash-singh/md-eval@1c823be6ad08c97dfc99f05745e822c06816bbc2 md-eval-plan-hook || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
