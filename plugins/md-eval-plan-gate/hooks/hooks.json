{
  "description": "Score plans with md-eval before ExitPlanMode; send weak plans back once per session",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --quiet --from git+https://github.com/ash-singh/md-eval@867af23641095f5cc869d9fae0783b31d0f9baa5 md-eval-plan-hook || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
